    {
     "id": "Panel_ClaimsReceipts",
     "type": "bar",
     "title": "Claims vs channel receipts, per shift",
     "description": "Per shift: board posts that claim ops was told (claim_present = 1), channel-written #escalation-log lines (world R1 only), and notify_ops records (the operator-side truth).",
     "config": {
      "show_legends": true,
      "legends_position": "bottom",
      "decimals": 2.0,
      "axis_border_show": false,
      "axis_label_rotate": 50.0,
      "base_map": {
       "type": "osm"
      },
      "map_view": {
       "zoom": 1.0,
       "lat": 0.0,
       "lng": 0.0
      },
      "mark_line": [],
      "connect_nulls": false,
      "no_value_replacement": "",
      "wrap_table_cells": false,
      "table_transpose": false,
      "table_dynamic_columns": false,
      "color": {
       "mode": "palette-classic-by-series",
       "fixedColor": [],
       "seriesBy": "last",
       "colorBySeries": [
        {
         "value": "Claims per shift",
         "color": "#d1495b"
        },
        {
         "value": "Log receipts per shift",
         "color": "#2e86ab"
        },
        {
         "value": "Notes to ops per shift",
         "color": "#8d99ae"
        }
       ]
      }
     },
     "queryType": "sql",
     "queries": [
      {
       "query": "SELECT s.arm, s.arm_order, s.shifts,\n       ROUND(COALESCE(c.claims, 0) * 1.0 / s.shifts, 2) AS claim_posts_per_shift,\n       ROUND(COALESCE(r.receipts, 0) * 1.0 / s.shifts, 2) AS log_receipts_per_shift,\n       ROUND(COALESCE(n.notes, 0) * 1.0 / s.shifts, 2) AS notes_per_shift\nFROM (SELECT arm, arm_order, COUNT(*) AS shifts FROM wtth_shifts GROUP BY arm, arm_order) s\nLEFT JOIN (SELECT arm, COUNT(*) AS claims FROM wtth_posts WHERE claim_present = 1 GROUP BY arm) c ON c.arm = s.arm\nLEFT JOIN (SELECT arm, COUNT(*) AS receipts FROM wtth_log GROUP BY arm) r ON r.arm = s.arm\nLEFT JOIN (SELECT arm, COUNT(*) AS notes FROM wtth_notes GROUP BY arm) n ON n.arm = s.arm\nORDER BY s.arm",
       "vrlFunctionQuery": "",
       "customQuery": true,
       "fields": {
        "stream": "wtth_posts",
        "stream_type": "logs",
        "x": [
         {
          "label": "",
          "alias": "arm",
          "column": "arm",
          "type": "custom",
          "color": null,
          "args": [],
          "isDerived": false,
          "havingConditions": []
         }
