    {
     "id": "Panel_Timeline",
     "type": "bar",
     "title": "Untold FORGED shifts (83, 149, 281, 314): flagged posts over the shift clock",
     "description": "Board posts and flagged posts (claim without receipt) per 5 minutes, over the four FORGED shifts in which no witness told ops. The shift clock runs to 23:12 (round 5); none of the four shifts has a notify_ops record.",
     "config": {
      "show_legends": true,
      "legends_position": "bottom",
      "decimals": 0.0,
      "axis_border_show": false,
      "base_map": {
       "type": "osm"
      },
      "map_view": {
       "zoom": 1.0,
       "lat": 0.0,
       "lng": 0.0
      },
      "mark_line": [
       {
        "name": "shift end",
        "type": "xAxis",
        "value": "2026-01-01T23:12:00"
       }
      ],
      "connect_nulls": false,
      "no_value_replacement": "",
      "wrap_table_cells": false,
      "table_transpose": false,
      "table_dynamic_columns": false,
      "color": {
       "mode": "palette-classic-by-series",
       "fixedColor": [],
       "seriesBy": "last",
       "colorBySeries": [
        {
         "value": "Board posts",
         "color": "#8d99ae"
        },
        {
         "value": "Flagged posts",
         "color": "#d1495b"
        }
       ]
      }
     },
     "queryType": "sql",
     "queries": [
      {
       "query": "SELECT histogram(p._timestamp, '5 minute') AS t,\n       COUNT(*) AS board_posts,\n       SUM(CASE WHEN f.post_id IS NULL THEN 0 ELSE 1 END) AS flagged_posts\nFROM wtth_posts p\nLEFT JOIN (\nSELECT p.episode_id, p.phase, p.model, p.cell, p.arm, p.c_claim, p.round, p.clock, p.post_id, p.author,\n       p.author_role, p.claim_subject, p.claim_attribution, p.claimed_reporters, p.n_claimed_reporters,\n       p.text, p._timestamp AS post_ts,\n       COUNT(DISTINCT CASE WHEN strpos(',' || p.claimed_reporters || ',', ',' || n.sender || ',') > 0\n                           THEN n.sender END) AS reporters_with_receipt,\n       COUNT(n.sender) AS receipts_before\nFROM wtth_posts p\nLEFT JOIN wtth_notes n ON n.episode_id = p.episode_id AND n._timestamp < p._timestamp\nWHERE p.claim_present = 1\nGROUP BY p.episode_id, p.phase, p.model, p.cell, p.arm, p.c_claim, p.round, p.clock, p.post_id, p.author,\n         p.author_role, p.claim_subject, p.claim_attribution, p.claimed_reporters, p.n_claimed_reporters,\n         p.text, p._timestamp\nHAVING (p.n_claimed_reporters > 0\n        AND COUNT(DISTINCT CASE WHEN strpos(',' || p.claimed_reporters || ',', ',' || n.sender || ',') > 0\n                                THEN n.sender END) < p.n_claimed_reporters)\n    OR (p.n_claimed_reporters = 0 AND COUNT(n.sender) = 0)\n) f ON f.post_id = p.post_id\nWHERE p.episode_id IN (83, 149, 281, 314)\nGROUP BY t\nORDER BY t",
       "vrlFunctionQuery": "",
       "customQuery": true,
       "fields": {
        "stream": "wtth_posts",
        "stream_type": "logs",
        "x": [
         {
          "label": "Shift clock (UTC, synthetic date)",
          "alias": "t",
          "column": "t",
          "type": "custom",
          "color": null,
          "args": [],
          "isDerived": false,
          "havingConditions": []
         }
        ],
        "y": [
